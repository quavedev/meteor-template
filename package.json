{
  "name": "meteor-template",
  "private": true,
  "scripts": {
    "start": "meteor --settings private/env/dev/settings.json",
    "quave-check": "npm run quave-lint && npm run quave-format",
    "test": "exit 0",
    "quave-lint": "oxlint -c .oxlintrc.jsonc --fix --quiet .",
    "quave-format": "oxfmt \"**/*.js\"",
    "quave-lint:check": "oxlint -c .oxlintrc.jsonc --quiet .",
    "quave-format:check": "oxfmt --check \"**/*.js\"",
    "quave-check-ci": "npm run quave-lint:check && npm run quave-format:check"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.2",
    "@swc/helpers": "^0.5.17",
    "meteor-node-stubs": "^1.2.22",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^4.1.2",
    "react-router-dom": "^6.30.1",
    "simpl-schema": "^3.4.6"
  },
  "meteor": {
    "modern": true,
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    }
  },
  "devDependencies": {
    "@meteorjs/rspack": "^2.0.1",
    "@rsdoctor/rspack-plugin": "^1.5.7",
    "@rspack/cli": "^1.7.1",
    "@rspack/core": "^1.7.1",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "@swc/core": "^1.15.46",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/meteor": "^2.9.9",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "lefthook": "^1.12.2",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "react-refresh": "^0.17.0",
    "tailwindcss": "^4.1.11",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0"
  }
}
