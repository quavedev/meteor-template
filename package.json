{
  "name": "meteor-template",
  "private": true,
  "scripts": {
    "start": "meteor --settings private/env/dev/settings.json",
    "quave-check": "npm run quave-lint && npm run quave-format",
    "test": "exit 0",
    "quave-lint": "oxlint -c .oxlintrc.jsonc --fix --quiet .",
    "quave-format": "oxfmt \"**/*.js\"",
    "quave-lint:check": "oxlint -c .oxlintrc.jsonc --quiet .",
    "quave-format:check": "oxfmt --check \"**/*.js\"",
    "quave-check-ci": "npm run quave-lint:check && npm run quave-format:check"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@swc/helpers": "^0.5.23",
    "meteor-node-stubs": "^1.2.27",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-router-dom": "^6.30.4",
    "simpl-schema": "^3.4.7"
  },
  "meteor": {
    "modern": true,
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    }
  },
  "devDependencies": {
    "@meteorjs/rspack": "^2.1.0-beta.0",
    "@rsdoctor/rspack-plugin": "^1.6.1",
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "@rspack/plugin-react-refresh": "^1.6.2",
    "@swc/core": "^1.15.47",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/meteor": "^2.9.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.25",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.18.0",
    "tailwindcss": "^4.3.3"
  }
}
